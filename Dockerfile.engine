FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY cpp-engine ./cpp-engine

WORKDIR /src/cpp-engine
RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target pamguard_engine_service ffmpeg_stream_ingest

FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PAMGUARD_HTTP_THREADS=32
ENV PAMGUARD_MAX_PCM_BODY_BYTES=8388608
ENV PAMGUARD_MAX_ARCHIVE_QUERY_RECORDS=10000
ENV PAMGUARD_CORS_ORIGIN=*
ENV PAMGUARD_PROJECT_DIR=/data/projects

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /src/cpp-engine/build/pamguard_engine_service /app/pamguard_engine_service
COPY --from=build /src/cpp-engine/build/ffmpeg_stream_ingest /app/ffmpeg_stream_ingest
COPY platform/ingest-sources.example.json /app/ingest-sources.example.json
COPY platform/openapi.yaml /app/openapi.yaml
COPY ops/ingest_supervisor.py /app/ops/ingest_supervisor.py
COPY ops/archive_retention.py /app/ops/archive_retention.py
COPY ops/archive_retention_smoke.py /app/ops/archive_retention_smoke.py
COPY ops/rebuild_archive_event_index.py /app/ops/rebuild_archive_event_index.py
COPY ops/rebuild_archive_event_index_smoke.py /app/ops/rebuild_archive_event_index_smoke.py
RUN mkdir -p /app/web-ui/assets/platform
COPY web-ui/index.html /app/web-ui/index.html
COPY web-ui/assets/platform/dom.js \
     web-ui/assets/platform/http.js \
     web-ui/assets/platform/identifiers.js \
     web-ui/assets/platform/lifecycle.js \
     web-ui/assets/platform/project-client.js \
     /app/web-ui/assets/platform/
COPY web-ui/assets/matched-template-default-templates.json \
     web-ui/assets/project-array-settings.css \
     web-ui/assets/project-array-settings.js \
     web-ui/assets/project-audio.js \
     web-ui/assets/project-click-settings.css \
     web-ui/assets/project-click-settings.js \
     web-ui/assets/project-clip-generator-settings.css \
     web-ui/assets/project-clip-generator-settings.js \
     web-ui/assets/project-displays.js \
     web-ui/assets/project-filter-settings.css \
     web-ui/assets/project-filter-settings.js \
     web-ui/assets/project-ishmael-settings.css \
     web-ui/assets/project-ishmael-settings.js \
     web-ui/assets/project-level-meter-settings.css \
     web-ui/assets/project-level-meter-settings.js \
     web-ui/assets/project-matched-template-settings.css \
     web-ui/assets/project-matched-template-settings.js \
     web-ui/assets/project-mht-click-train-settings.css \
     web-ui/assets/project-mht-click-train-settings.js \
     web-ui/assets/project-noise-ltsa-settings.css \
     web-ui/assets/project-noise-ltsa-settings.js \
     web-ui/assets/project-shell.css \
     web-ui/assets/project-shell.js \
     web-ui/assets/project-signal-routing-settings.css \
     web-ui/assets/project-signal-routing-settings.js \
     web-ui/assets/project-sound-recorder-settings.css \
     web-ui/assets/project-sound-recorder-settings.js \
     web-ui/assets/project-templates.css \
     web-ui/assets/project-templates.js \
     web-ui/assets/project-whistle-moan-settings.css \
     web-ui/assets/project-whistle-moan-settings.js \
     /app/web-ui/assets/

ENV PAMGUARD_WEB_UI_FILE=/app/web-ui/index.html
ENV PAMGUARD_OPENAPI_FILE=/app/openapi.yaml

VOLUME ["/data"]

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD python3 -c "import json, urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)); raise SystemExit(0 if data.get('ok') else 1)"

CMD ["/app/pamguard_engine_service", "8080"]
